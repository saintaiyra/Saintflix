# Backend para Railway/Render
# Copie este arquivo para backend/.env no servidor (não commite!)

NODE_ENV=production
PORT=5000

# MongoDB Atlas (obrigatório - não use localhost)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/netflix-clone?retryWrites=true&w=majority

# JWT - Gere uma chave forte: openssl rand -base64 32
JWT_SECRET=sua_chave_jwt_super_secreta_com_pelo_menos_32_caracteres_aqui_123456

# URL do Frontend no Vercel (para CORS)
FRONTEND_URL=https://seu-projeto.vercel.app

# Stripe - Chaves de PRODUÇÃO (Dashboard Stripe → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...  # Configure após deploy (ver abaixo)

# TMDB API (para busca de filmes)
TMDB_API_KEY=sua_chave_tmdb
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p